# LibreSeal configuration template.
#
# Do not copy this file by hand: run ./scripts/libreseal-init.sh, which writes
# .env from this template with fresh random secrets. Every value marked
# __GENERATED__ is replaced by `openssl rand -hex 32`.
#
# Warning: .env holds secrets. Keep it out of version control (it is listed in
# .gitignore) and readable only by the operator (the init script sets 0600).

# Public hostname (no scheme, no port) and the full URL users and the CLI use.
HOST=localhost
PUBLIC_URL=https://localhost

# Host ports published by the nginx container.
HTTP_PORT=80
HTTPS_PORT=443

# Whitelist email domains that users are allowed to sign in with, as a comma-separated list.
# Leave commented to allow all email domains.
#USER_EMAIL_DOMAIN_WHITELIST=mydomain.com,subdomain.mydomain.com

# Application secrets.
NEXTAUTH_SECRET=__GENERATED__
SECRET_KEY=__GENERATED__
SERVER_SECRET=__GENERATED__

# Sign-in methods. Password sign-in is enabled for a homelab-friendly default.
# Optional OAuth/OIDC providers (comma-separated): google, github, gitlab, authentik, authelia
SSO_PROVIDERS=
ENABLE_PASSWORD_AUTH=true

# OAuth provider credentials, for each provider listed in SSO_PROVIDERS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
#AUTHENTIK_URL=https://authentik.example.com
#AUTHENTIK_APP_SLUG=libreseal
#AUTHENTIK_CLIENT_ID=
#AUTHENTIK_CLIENT_SECRET=
#AUTHELIA_URL=https://auth.example.com
#AUTHELIA_CLIENT_ID=
#AUTHELIA_CLIENT_SECRET=

# GitHub secret-sync integration OAuth credentials (optional).
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=

# Database. Keep DATABASE_HOST=postgres for the bundled Docker Compose setup.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=libreseal
DATABASE_USER=libreseal
DATABASE_PASSWORD=__GENERATED__

# Networks allowed to set X-Real-IP / X-Forwarded-For (comma-separated CIDRs).
# Empty = loopback and private ranges, which is safe only for the bundled
# Compose setup (the backend port is not published). Anywhere else (Kubernetes,
# shared networks, a reachable backend port) set it to your proxy's address,
# e.g. 10.42.0.15/32. Entries that trust everyone (0.0.0.0/0, ::/0) are ignored.
TRUSTED_PROXY_CIDRS=

# Reverse proxies in front of the bundled nginx (Traefik, Caddy, Cloudflare
# Tunnel...): comma-separated IPs/CIDRs allowed to tell nginx the real client
# IP, and the header they use. Empty = nginx uses the connecting address and
# ignores client-supplied forwarding headers. Cloudflare: list Cloudflare's
# published ranges and set NGINX_REAL_IP_HEADER=CF-Connecting-IP.
NGINX_REAL_IP_FROM=
NGINX_REAL_IP_HEADER=X-Forwarded-For

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
